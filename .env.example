# Copy this file to .env and fill in your values before running docker compose up

# ---- Host user/timezone ----
PUID=1000
PGID=1000
TZ=America/New_York

# ---- Media/download paths on the host ----
DOWNLOADS_PATH=./downloads
TV_PATH=./media/tv
MOVIES_PATH=./media/movies

# ---- Admin panel ----
# Password for the setup/management web page at http://<host>:5400
ADMIN_PASSWORD=changeme

# ---- Mullvad VPN (for Transmission) ----
# Generate a WireGuard key and register it with your Mullvad account first:
#   wg genkey | tee private.key | wg pubkey
#   curl https://api.mullvad.net/wg/ --data-urlencode "account=<your-account-number>" \
#     --data-urlencode "pubkey=$(cat private.key | wg pubkey ... )"
# The curl call returns the address to put in MULLVAD_ADDRESSES.
MULLVAD_PRIVATE_KEY=
MULLVAD_ADDRESSES=
MULLVAD_CITY=New York
